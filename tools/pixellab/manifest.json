{
  "staff_base": {
    "endpoint": "/create-character-v3",
    "note": "직원 기본 캐릭터 (8방향). 색 변형은 제가 후처리로 만듭니다",
    "body": {
      "description": "friendly parcel delivery hub worker, orange safety vest over white shirt, dark blue cap, brown hair, simple clean chibi pixel art, readable at small size",
      "image_size": {
        "width": 48,
        "height": 48
      },
      "view": "low top-down",
      "outline": "thin",
      "detail": "medium"
    }
  },
  "staff_walk": {
    "endpoint": "/animate-character",
    "note": "직원 걷기 (4방향, 6프레임). staff_base 를 먼저 만들어야 함",
    "character_of": "staff_base",
    "body": {
      "character_id": "{staff_base.character_id}",
      "action_description": "walking",
      "frame_count": 6,
      "directions": [
        "south",
        "east",
        "north",
        "west"
      ],
      "mode": "v3"
    },
    "per_direction": true
  },
